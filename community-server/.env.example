# The public website's origin. GitHub redirects to this website, which proxies the callback.
COMMUNITY_WEB_ORIGIN=http://localhost:3000
# Public API hostname used by compose.https.yaml.
COMMUNITY_API_DOMAIN=crossomics-community.duckdns.org
COMMUNITY_GITHUB_CLIENT_ID=
COMMUNITY_GITHUB_CLIENT_SECRET=
COMMUNITY_GOOGLE_CLIENT_ID=
COMMUNITY_GOOGLE_CLIENT_SECRET=
COMMUNITY_APPLE_CLIENT_ID=
COMMUNITY_APPLE_TEAM_ID=
COMMUNITY_APPLE_KEY_ID=
# Apple .p8 contents, using literal \n escapes for newlines in a single-line variable.
COMMUNITY_APPLE_PRIVATE_KEY=
# Generate with openssl rand -hex 32
COMMUNITY_SESSION_SECRET=

# Use DATABASE_URL for npm-based runs. Compose sets it from COMMUNITY_DB_PASSWORD.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/community
# Use a random hex value from openssl rand -hex 32
COMMUNITY_DB_PASSWORD=

# Comma-separated Community account IDs that can post and manage bounties.
COMMUNITY_BOUNTY_EDITOR_IDS=
